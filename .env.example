# Environment Variables — منصة الأوس الماسية
# انسخ هذا الملف إلى .env.local (محلياً) أو .env.production (على السيرفر) وأضف القيم الفعلية. لا ترفع القيم إلى git.
#
# مهم للاستضافة الذاتية (cPanel): كل هذه المتغيرات يجب أن تكون موجودة أثناء `npm run build`
# وليس وقت التشغيل فقط: قيم NEXT_PUBLIC_* تُدمج في الحزم وقت البناء، وبعض مسارات الـ API
# (cron/push) تقرأ الأسرار عند تحميل الوحدة أثناء البناء. غيّرت قيمة NEXT_PUBLIC_*؟ أعد البناء.

# ── Supabase ─────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── الموقع ───────────────────────────────────────────────────
# الأصل العام للموقع بدون شرطة أخيرة. يُستخدم في تحويلات ما بعد المصادقة ورابط التحقق في الشهادة.
NEXT_PUBLIC_SITE_URL=https://example.com

# ── Web Push (VAPID) ──────────────────────────────────────────
# يجب أن تكون نفس القيم على كل بيئة إنتاج، وإلا تبطل اشتراكات الطلاب الحالية.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# ── المهام المجدولة ──────────────────────────────────────────
# تُرسل في ترويسة Authorization: Bearer <CRON_SECRET> عند استدعاء /api/cron/*
CRON_SECRET=

# ── UltraMsg (WhatsApp) ───────────────────────────────────────
# https://www.ultramsg.com → Instances
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# ── البناء على استضافة مشتركة (اختياري) ──────────────────────
# يحدّ عدد عمّال التوليد الثابت فقط أثناء `next build`. إن قُتل البناء في مرحلة webpack (Creating an optimized production build)
# فهذا لا يساعد؛ ابنِ خارجياً على Linux وارفع الناتج (انظر DEPLOY_CPANEL.md).
# NEXT_BUILD_CPUS=1
